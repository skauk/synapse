# Copy to .dev.vars (gitignored). For deploys use `wrangler secret put <NAME>`.
BOT_API_TOKEN=demo-bot-token
OIDC_CLIENT_SECRET=
# Matrix application service tokens, demo values shared with docker-compose.yml
AS_TOKEN=demo-as-token-local-only
HS_TOKEN=demo-hs-token-local-only
# Local overrides of wrangler.jsonc, which is the deployed config
IDP=mock
BASE_URL=http://localhost:8787
FHIR_BASE_URL=http://localhost:8080/fhir
MAIL_MODE=outbox
# Matrix and bot limits for local runs (the deployed values are in wrangler.jsonc)
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_MEMBERS=@lena.hofer:klinikum.example
MATRIX_OPEN=false
BOT_MAX_MESSAGES=0
BOT_ACTIVE_DATE=
ALLOWED_PATIENTS=
