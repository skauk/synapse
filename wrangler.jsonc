{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synapse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // This file is the deployed configuration. Local runs override it with .dev.vars
  // (IDP=mock, BASE_URL=http://localhost:8787, local FHIR server). Secrets (BOT_API_TOKEN,
  // OIDC_CLIENT_SECRET, AS_TOKEN, HS_TOKEN) go in `wrangler secret put` for deploys.
  "vars": {
    // "oidc" or "mock". The mock IdP and the /outbox mail catcher only run when BASE_URL is localhost.
    "IDP": "oidc",
    // The redirect URI registered with ID Austria is BASE_URL + /auth/callback.
    "BASE_URL": "https://synapse.skauk.workers.dev",
    "SENDER_ORG": "Klinikum Beispielstadt",
    // FHIR R4 base URL. Deployed: the public HAPI test server. Locally: the container from docker-compose.yml.
    "FHIR_BASE_URL": "https://hapi.fhir.org/baseR4",
    // Matrix: the homeserver the Worker calls, the bot account of the application service, and the
    // directory of members who may send requests (comma separated). Secrets AS_TOKEN and HS_TOKEN: see scripts/matrix-setup.sh.
    "MATRIX_HOMESERVER_URL": "http://localhost:8008",
    "MATRIX_BOT_USER": "@pgkbot:klinikum.example",
    "MATRIX_MEMBERS": "@lena.hofer:klinikum.example",

    // ID Austria reference environment (OIDC). Its discovery document lists only the scopes openid and
    // profile, client_secret_post and claims_parameter_supported: attributes must be requested with the
    // `claims` parameter and arrive in the ID token (there is no userinfo endpoint).
    "OIDC_ISSUER": "https://idp.ref.id-austria.gv.at",
    // Tentative: the "Friendly URL" of the service provider version. Unconfirmed until the IdP accepts it
    // (see scripts/probe-idp.sh). The other candidate is the "API ID" IQEXWIDWC43WHJ6A.
    "OIDC_CLIENT_ID": "https://kauk.at",
    "OIDC_SCOPES": "openid profile",
    "OIDC_CLIENT_AUTH": "post",
    // Claims to request. The urn:pvpgvat names are unverified guesses: the first real login reports which
    // claim names arrive (see the identity_checked audit entry), then adjust here. No birth date: it is not needed.
    "OIDC_CLAIMS_REQUEST": "{\"id_token\":{\"urn:pvpgvat:oidc.bpk\":null,\"urn:pvpgvat:oidc.given_name\":null,\"urn:pvpgvat:oidc.family_name\":null,\"given_name\":null,\"family_name\":null}}",
    // Candidate claim names per field, comma separated, first present wins.
    "OIDC_CLAIM_GIVEN_NAME": "urn:pvpgvat:oidc.given_name,given_name",
    "OIDC_CLAIM_FAMILY_NAME": "urn:pvpgvat:oidc.family_name,family_name",
    "OIDC_CLAIM_BPK": "urn:pvpgvat:oidc.bpk,bpk",
    "OIDC_CLAIM_LOA": "acr"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "aimh-gateway", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REQUEST", "class_name": "RequestDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RequestDO"] }]
}
