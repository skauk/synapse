{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synapse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker is served on its own domain; the zone must be in the same Cloudflare account. The ID Austria service
  // provider must have BASE_URL + /auth/callback registered as a redirect URI. workers.dev stays on during the move.
  "routes": [{ "pattern": "synapse.dingsbums.click", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // This file is the deployed configuration. Local runs override it with .dev.vars
  // (IDP=mock, BASE_URL=http://localhost:8787, local FHIR server). Secrets (BOT_API_TOKEN,
  // OIDC_CLIENT_SECRET, AS_TOKEN, HS_TOKEN) go in `wrangler secret put` for deploys.
  "vars": {
    // "oidc" or "mock". The mock IdP and the /outbox mail catcher only run when BASE_URL is localhost.
    "IDP": "oidc",
    // The redirect URI registered with ID Austria is BASE_URL + /auth/callback.
    "BASE_URL": "https://synapse.dingsbums.click",
    "SENDER_ORG": "Klinikum Beispielstadt",
    // FHIR R4 base URL. Deployed: the public HAPI test server. Locally: the container from docker-compose.yml.
    "FHIR_BASE_URL": "https://hapi.fhir.org/baseR4",
    // Matrix. The homeserver is the public demo server (tunnelled from the home server). The bot is an
    // application service; secrets AS_TOKEN and HS_TOKEN must match its registration file.
    "MATRIX_HOMESERVER_URL": "https://matrix.dingsbums.click",
    "MATRIX_BOT_USER": "@pgkbot:klinikum.example",
    // Accounts that may invite the bot into a room (and, unless MATRIX_OPEN, send requests). Comma separated.
    "MATRIX_MEMBERS": "@host:klinikum.example",
    // "true": anyone in a room with the bot may send commands. Limited by the settings below.
    "MATRIX_OPEN": "true",
    // Commands per Matrix user and day (0 = unlimited) and the only date (Europe/Vienna, YYYY-MM-DD) the bot answers ("" = any).
    "BOT_MAX_MESSAGES": "10",
    "BOT_ACTIVE_DATE": "2026-10-30",
    // Patient ids that may be requested ("" = any). The public FHIR server holds other people's test data.
    "ALLOWED_PATIENTS": "aimh-skauk-maria-beispiel",

    // "cloudflare" sends the request email for real, "mailpit" hands it to a local mail catcher, "outbox" only records it. Addresses on reserved domains
    // (.example, .test, ...) are never sent to. MAIL_REDIRECT_TO sends every request email to one test mailbox instead.
    "MAIL_MODE": "cloudflare",
    "MAIL_FROM": "requests@dingsbums.click",
    "MAIL_FROM_NAME": "Klinikum Beispielstadt (demo)",
    "MAIL_REDIRECT_TO": "",
    // Only for MAIL_MODE=mailpit (the local Docker stack): base URL of the Mailpit container.
    "MAILPIT_URL": "",

    // ID Austria reference environment (OIDC). Its discovery document lists only the scopes openid and
    // profile, client_secret_post and claims_parameter_supported: attributes must be requested with the
    // `claims` parameter and arrive in the ID token (there is no userinfo endpoint).
    "OIDC_ISSUER": "https://idp.ref.id-austria.gv.at",
    // Tentative: the "Friendly URL" of the service provider version. Unconfirmed until the IdP accepts it
    // (see scripts/probe-idp.sh). The other candidate is the "API ID" IQEXWIDWC43WHJ6A.
    "OIDC_CLIENT_ID": "https://kauk.at",
    "OIDC_SCOPES": "openid profile",
    "OIDC_CLIENT_AUTH": "post",
    // Claims to request. The urn:pvpgvat names are unverified guesses: the first real login reports which
    // claim names arrive (see the identity_checked audit entry), then adjust here. No birth date: it is not needed.
    "OIDC_CLAIMS_REQUEST": "{\"id_token\":{\"urn:pvpgvat:oidc.bpk\":null,\"urn:pvpgvat:oidc.given_name\":null,\"urn:pvpgvat:oidc.family_name\":null,\"given_name\":null,\"family_name\":null}}",
    // Candidate claim names per field, comma separated, first present wins.
    "OIDC_CLAIM_GIVEN_NAME": "urn:pvpgvat:oidc.given_name,given_name",
    "OIDC_CLAIM_FAMILY_NAME": "urn:pvpgvat:oidc.family_name,family_name",
    "OIDC_CLAIM_BPK": "urn:pvpgvat:oidc.bpk,bpk",
    "OIDC_CLAIM_LOA": "acr",
    // Minimum eIDAS level the eID must reach: low, substantial or high. The reference IdP reports high in `acr`.
    "MIN_LOA": "substantial"
  },

  // Cloudflare Email Service. The sending domain (MAIL_FROM) must be onboarded: `wrangler email sending enable <domain>`.
  "send_email": [{ "name": "EMAIL" }],

  "d1_databases": [
    { "binding": "DB", "database_name": "aimh-gateway", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REQUEST", "class_name": "RequestDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RequestDO"] }]
}
